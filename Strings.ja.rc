BEGIN
    IDS_MSG_21496    "The amulet spits some multicolored sparks."
    IDS_MSG_21497    "You focus mana into the amulet...."
    IDS_MSG_21498    "The Sceptre makes a sort of dull 'thut' noise."
    IDS_MSG_21499    "With a shriek of tearing aether, a magic portal appears!"
    IDS_MSG_21500    "Step through? [yn] "
