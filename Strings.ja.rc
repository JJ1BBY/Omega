// ==================== mon.c ====================
STRINGTABLE
BEGIN
    IDS_MSG_21603    "Death lies sprawled out on the ground......"
    IDS_MSG_21604    "Death laughs ironically and gets back to its feet."
    IDS_MSG_21605    "It gestures and another scythe appears in its hands."
    IDS_MSG_21606    "Death performs a little bow and goes back on guard."
    IDS_MSG_21607    "'A hit! A palpable hit!' Death goes back on the attack."
    IDS_MSG_21608    "'Ah, if only it could be so simple!' snickers Death."
    IDS_MSG_21609    "'You think Death can be slain?  What a jest!' says Death."
    IDS_MSG_21610    "'Your point is well taken.' says Death, attacking again."
    IDS_MSG_21611    "'Oh, come now, stop delaying the inevitable.' says Death."
    IDS_MSG_21612    "'Your destiny ends here with me.' says Death, scythe raised."
    IDS_MSG_21613    "'I almost felt that.' says Death, smiling."
    IDS_MSG_21614    "'Timeo Mortis?' asks Death quizzically, 'Not me!'"
    IDS_MSG_21615    "Death sighs theatrically. 'They never learn.'"
    IDS_MSG_21616    "You hear a faroff dirge. You feel a sense of triumph."
    IDS_MSG_21617    "You hear a faroff sound like angels crying...."
    IDS_MSG_21618    "A furtive figure dashes out of the shadows, takes a look at"
    IDS_MSG_21619    "the corpse, and runs away!"
    IDS_MSG_21620    "An aide-de-camp approaches, removes the corpse's insignia,"
    IDS_MSG_21621    "and departs."
