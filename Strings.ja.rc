// ==================== mtalk.c ====================
STRINGTABLE
BEGIN
    IDS_MSG_21997    "The Archdruid raises a hand in greeting."
    IDS_MSG_21998    "The Archdruid congratulates you on reaching his sanctum."
    IDS_MSG_21999    "You feel competent."
    IDS_MSG_22000    "The Archdruid conveys to you the wisdom of nature...."
    IDS_MSG_22001    "You feel like a sage."
    IDS_MSG_22002    "Do you request a ritual of neutralization? [yn] "
    IDS_MSG_22003    """Unfortunately, I cannot perform a ritual of balance on"
    IDS_MSG_22004    "this lawful day."""
    IDS_MSG_22005    "this chaotic day."""
    IDS_MSG_22006    "You take part in today's holy celebration of balance..."
    IDS_MSG_22007    "The ArchDruid conducts a sacred rite of balance..."
    IDS_MSG_22008    "The ArchDruid looks at you and cries: 'Unclean! Unclean!'"
    IDS_MSG_22009    "This seems to have satiated his desire for vengeance."
    IDS_MSG_22010    "'Have you learned your lesson?' The ArchDruid asks. [yn] "
    IDS_MSG_22011    "'I certainly hope so!' says the ArchDruid."
    IDS_MSG_22012    "'Idiot.' mutters the ArchDruid."
    IDS_MSG_22013    "'Surrender in the name of the Law!'"
    IDS_MSG_22014    "Do it? [yn] "
    IDS_MSG_22015    "Go directly to jail. Do not pass go, do not collect 200Au."
    IDS_MSG_22016    "You are taken to the city gaol."
    IDS_MSG_22017    "Mollified, the guard disarms you and sends you away."
    IDS_MSG_22018    "All right, you criminal scum, you asked for it!"
    IDS_MSG_22019    "'Greetings comrade! May you always tread the paths of Law.'"
    IDS_MSG_22020    "Move it right along, stranger!"
    IDS_MSG_22021    "The mendicant priest asks you to spare some treasure for the needy"
    IDS_MSG_22022    "The black-garbed figure says apologetically:"
    IDS_MSG_22023    "'Situree simasita, wakarimasen.'"
    IDS_MSG_22024    "The cloaked figure makes a gesture which you recognize..."
    IDS_MSG_22025    "...the thieves' guild recognition signal!"
    IDS_MSG_22026    "'Sorry, mate, thought you were a mark....'"
    IDS_MSG_22027    "The ominous figure does not reply, but hands you an embossed card:"
    IDS_MSG_22028    "'Guild of Assassins Ops are forbidden to converse with targets.'"
    IDS_MSG_22029    "The merchant says: Alas! I have nothing to sell!"
    IDS_MSG_22030    "I have a fine"
    IDS_MSG_22031    "for only"
    IDS_MSG_22032    "Want it? [yn] "
    IDS_MSG_22033    "Well, I'll let you have it for what you've got."
    IDS_MSG_22034    "Beat it, you deadbeat!"
    IDS_MSG_22035    "Here you are. Have a good day."
    IDS_MSG_22036    "Well then, I must be off. Good day."
    IDS_MSG_22037    "It can't talk -- it's too slithy!"
    IDS_MSG_22038    "It can't talk -- it's too mimsy!"
    IDS_MSG_22039    "The good fairy glints: Would you like a wish?"
    IDS_MSG_22040    "The good fairy glows: Are you sure?"
    IDS_MSG_22041    "The good fairy radiates: Really really sure?"
    IDS_MSG_22042    "The good fairy beams: I mean, like, sure as sure can be?"
    IDS_MSG_22043    "The good fairy dazzles: You don't want a wish, right?"
    IDS_MSG_22044    "The good fairy laughs: I thought not."
    IDS_MSG_22045    "In a flash of sweet-smelling light, the fairy vanishes...."
    IDS_MSG_22046    "You feel mellow."
    IDS_MSG_22047    "The evil fairy roils: Eat my pixie dust!"
    IDS_MSG_22048    "She waves her black-glowing wand, which screams thinly...."
    IDS_MSG_22049    "Flee? [yn] "
    IDS_MSG_22050    "You feel fortunate...."
    IDS_MSG_22051    "You feel your life energies draining..."
    IDS_MSG_22052    "You now notice the fangs, claws, batwings..."
    IDS_MSG_22053    "The horse neighs angrily at you."
    IDS_MSG_22054    "The horse noses curiously at your pack."
    IDS_MSG_22055    "The horse and your steed don't seem to get along."
    IDS_MSG_22056    "The horse shies; maybe he doesn't like the dungeon air...."
    IDS_MSG_22057    "The horse lets you pat his nose. Want to ride him? [yn] "
    IDS_MSG_22058    "You are now equitating!"
    IDS_MSG_22059    "The hyena only laughs at you..."
    IDS_MSG_22060    "Polly wanna cracker?"
    IDS_MSG_22061    "The Servant of Law pauses in thought for a moment."
    IDS_MSG_22062    "You are asked: Are there any Servants of Chaos hereabouts? [yn] "
    IDS_MSG_22063    "The Servant of Chaos grins mischievously at you."
    IDS_MSG_22064    "You are asked: Are there any Servants of Law hereabouts? [yn] "
    IDS_MSG_22065    "Show me."
    IDS_MSG_22066    "The Servant launches itself towards its enemy."
    IDS_MSG_22067    "In a blaze of combat, the Servants annihilate each other!"
    IDS_MSG_22068    "Right. Tell me about it. Idiot!"
    IDS_MSG_22069    "The servant shrugs and turns away."
    IDS_MSG_22070    "shows you a scholarly paper by Dolittle, D. Vet."
    IDS_MSG_22071    "which demonstrates that animals don't have speech centers"
    IDS_MSG_22072    "complex enough to communicate in higher languages."
    IDS_MSG_22073    "It giggles softly to itself and takes back the paper."
    IDS_MSG_22074    "A thinly echoing scream reaches your ears...."
    IDS_MSG_22075    "You feel doomed...."
    IDS_MSG_22076    "A bird appears and flies three times widdershins around your head."
    IDS_MSG_22077    "The Archmage ignores your attempt at conversation"
    IDS_MSG_22078    "and concentrates on his spellcasting...."
    IDS_MSG_22079    "The Archmage congratulates you on getting this far."
    IDS_MSG_22080    "He invites you to attempt the Throne of High Magic"
    IDS_MSG_22081    "but warns you that it is important to wield the Sceptre"
    IDS_MSG_22082    "before sitting on the throne."
    IDS_MSG_22083    "The Archmage smiles and makes an arcane gesture...."
    IDS_MSG_22084    "The Archmage tells you to find him again in his"
    IDS_MSG_22085    "Magical Court at the base of his castle in the mountains"
    IDS_MSG_22086    "of the far North-East; if you do he will give you some"
    IDS_MSG_22087    "important information."
    IDS_MSG_22088    "The merchant asks you if you want to buy a horse for 250GP."
    IDS_MSG_22089    "Pay the merchant? [yn] "
    IDS_MSG_22090    "The merchant says: 'Come back when you've got the cash!'"
    IDS_MSG_22091    "The merchant takes your money and tells you to select"
    IDS_MSG_22092    "any horse you want in the stables."
    IDS_MSG_22093    "He says: 'You'll want to get to know him before trying to"
    IDS_MSG_22094    "ride him. By the way, food for the horse is not included.'"
    IDS_MSG_22095    "The merchant runs off toward the bank, cackling gleefully."
    IDS_MSG_22096    "The merchant tells you to stop wasting his time."
    IDS_MSG_22097    "The merchant tells you to visit his stables at his village"
    IDS_MSG_22098    "for a great deal on a horse."
    IDS_MSG_22099    "The merchant ignores you and screams:"
    IDS_MSG_22100    "'Help! Help! I'm being oppressed!'"
    IDS_MSG_22101    "The Prime nods brusquely at you, removes a gem from his"
