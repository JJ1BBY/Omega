    IDS_MSG_21966    "The blindness quickly passes."
    IDS_MSG_21967    "The fungus chirps.... "
    IDS_MSG_21968    "The area is plunged into darkness."
    IDS_MSG_21969    "As the bogthing touches you, you feel a frisson of terror...."
    IDS_MSG_21970    "which you shake off."
    IDS_MSG_21971    "The bogthing's touch causes you scream in agony!"
    IDS_MSG_21972    "Your struggles grow steadily weaker...."
    IDS_MSG_21973    "You witness a hideous transformation!"
    IDS_MSG_21974    "You hear a distant howl."
    IDS_MSG_21975    "You feel a sudden loss of mana!"
    IDS_MSG_21976    "The angel summons a heavenly host!"
    IDS_MSG_21977    "The swarm expands!"
    IDS_MSG_21978    "You hear an aggravating humming noise."
    IDS_MSG_21979    "The Zombie Overlord makes a mystical gesture..."
    IDS_MSG_21980    "The manaburst explodes!"
    IDS_MSG_21981    "You get blasted!"
    IDS_MSG_21982    "You feel cold all over!"
    IDS_MSG_21983    "You feel toasty warm inside!"
    IDS_MSG_21984    "You hear the sound of a mirror shattering!"
    IDS_MSG_21985    "The dungeon shakes!"
    IDS_MSG_21986    "You feel secure."
    IDS_MSG_21987    "You feel a sharp tug.... You hold on!"
    IDS_MSG_21988    "You feel uneasy for a moment."
    IDS_MSG_21989    "The merchant screams: 'Help! Murder! Guards! Help!'"
    IDS_MSG_21990    "You hear the sound of police whistles and running feet."
    IDS_MSG_21991    "A storm of spells hits you!"
    IDS_MSG_21992    "You notice a number of dragons waking up...."
    IDS_MSG_21993    "You are struck by a quantity of firebolts."
