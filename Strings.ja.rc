// ==================== mspec.c ====================
STRINGTABLE
BEGIN
    IDS_MSG_21937    "You feel cursed!"
    IDS_MSG_21938    "The mendicant priest makes a mystical gesture...."
    IDS_MSG_21939    "You feel impressed..."
    IDS_MSG_21940    "The night gaunt grabs you and carries you off!"
    IDS_MSG_21941    "Its leathery wings flap and flap, and it giggles insanely."
    IDS_MSG_21942    "It tickles you cunningly to render you incapable of escape."
    IDS_MSG_21943    "Finally, it deposits you in a strange place."
    IDS_MSG_21944    "A cloud of poison gas surrounds you!"
    IDS_MSG_21945    "You can breathe freely, however."
    IDS_MSG_21946    "You are stricken with fear!"
    IDS_MSG_21947    "You master your reptile brain and stand fast."
    IDS_MSG_21948    "The demon uses its waning lifeforce to summon help!"
    IDS_MSG_21949    "The ghost moans horribly...."
    IDS_MSG_21950    "You've been terrorized!"
    IDS_MSG_21951    "It seems stronger..."
    IDS_MSG_21952    "You are surprised by a sudden treacherous attack!"
    IDS_MSG_21953    "You are shocked out of your reverie by the scream of battle!"
    IDS_MSG_21954    "Suddenly, from out of the shadows, a surprise attack!"
    IDS_MSG_21955    "A shriek of hatred causes you to momentarily freeze up!"
    IDS_MSG_21956    "You alertly sense the presence of an attacker!"
    IDS_MSG_21957    "A strange numbing sensation comes over you..."
    IDS_MSG_21958    "The Eater explodes in a burst of mana!"
