// ==================== mon.c ====================
STRINGTABLE
BEGIN
    IDS_MSG_21603    "Death lies sprawled out on the ground......"
    IDS_MSG_21604    "Death laughs ironically and gets back to its feet."
    IDS_MSG_21605    "It gestures and another scythe appears in its hands."
    IDS_MSG_21606    "Death performs a little bow and goes back on guard."
    IDS_MSG_21607    "'A hit! A palpable hit!' Death goes back on the attack."
    IDS_MSG_21608    "'Ah, if only it could be so simple!' snickers Death."
    IDS_MSG_21609    "'You think Death can be slain?  What a jest!' says Death."
    IDS_MSG_21610    "'Your point is well taken.' says Death, attacking again."
    IDS_MSG_21611    "'Oh, come now, stop delaying the inevitable.' says Death."
    IDS_MSG_21612    "'Your destiny ends here with me.' says Death, scythe raised."
    IDS_MSG_21613    "'I almost felt that.' says Death, smiling."
    IDS_MSG_21614    "'Timeo Mortis?' asks Death quizzically, 'Not me!'"
    IDS_MSG_21615    "Death sighs theatrically. 'They never learn.'"
    IDS_MSG_21616    "You hear a faroff dirge. You feel a sense of triumph."
    IDS_MSG_21617    "You hear a faroff sound like angels crying...."
    IDS_MSG_21618    "A furtive figure dashes out of the shadows, takes a look at"
    IDS_MSG_21619    "the corpse, and runs away!"
    IDS_MSG_21620    "An aide-de-camp approaches, removes the corpse's insignia,"
    IDS_MSG_21621    "and departs."
    IDS_MSG_21622    "An odd glow surrounds the corpse, and slowly fades."
    IDS_MSG_21623    "A demon materializes, takes a quick look at the corpse,"
    IDS_MSG_21624    "and teleports away with a faint popping noise."
    IDS_MSG_21625    "A sports columnist rushes forward and takes a quick photo"
    IDS_MSG_21626    "of the corpse and rushes off muttering about a deadline."
    IDS_MSG_21627    "You hear a fanfare in the distance, and feel dismayed."
    IDS_MSG_21628    "You feel smug."
    IDS_MSG_21629    "You feel ashamed."
    IDS_MSG_21630    "In the distance you hear a trumpet. A Servant of Law"
    IDS_MSG_21631    "materializes, sheds a tear, picks up the badge, and leaves."
    IDS_MSG_21632    "materializes, sheds a tear, and leaves."
    IDS_MSG_21633    "A new justiciar has been promoted!"
    IDS_MSG_21634    "A Servant of Chaos materializes, grabs the corpse,"
    IDS_MSG_21635    "snickers a bit, and vanishes."
    IDS_MSG_21636    "You seem to hear a woman's voice from far off:"
    IDS_MSG_21637    "'Well done! Come to me now....'"
    IDS_MSG_21638    "A female voice sounds from just behind your ear:"
    IDS_MSG_21639    "'Well fought! I have some new advice for you....'"
    IDS_MSG_21640    "You feel a soft touch on your shoulder..."
    IDS_MSG_21641    "You turn around but there is no one there!"
    IDS_MSG_21642    "You turn back and see a note: 'See me soon.'"
    IDS_MSG_21643    "The note vanishes in a burst of blue fire!"
    IDS_MSG_21644    "Words appear before you, traced in blue flame!"
    IDS_MSG_21645    "'Return to the Prime Plane via the Circle of Sorcerors....'"
    IDS_MSG_21646    "Say Whutt? (npc talk weirdness)"
    IDS_MSG_21647    "Your deity is angry!"
    IDS_MSG_21648    "A bolt of godsfire strikes the monster...."
    IDS_MSG_21649    "The deity of the altar smiles on the monster...."
    IDS_MSG_21650    "A shaft of light zaps the altar..."
    IDS_MSG_21651    "but nothing much seems to happen"
END

// ==================== move.c ====================
STRINGTABLE
BEGIN
    IDS_MSG_21652    "Your heavy armor drags you under the water!"
    IDS_MSG_21653    "You reach the surface again."
    IDS_MSG_21654    "The weight of your burden drags you under water!"
    IDS_MSG_21655    "Splish. Splash!"
    IDS_MSG_21656    "I want my ducky!"
    IDS_MSG_21657    "So finally you take a bath!"
    IDS_MSG_21658    "You must be very thirsty!"
    IDS_MSG_21659    "Your horse frolics playfully in the water."
    IDS_MSG_21660    "Your horse quenches its thirst."
    IDS_MSG_21661    "Your steed begins to swim...."
    IDS_MSG_21662    "Your mount thrashes about in the water."
    IDS_MSG_21663    "Your steed tries to swim in the raw Chaos, but seems to"
    IDS_MSG_21664    "be having some difficulties..."
    IDS_MSG_21665    "probably because it's just turned into a chaffinch."
    IDS_MSG_21666    "You are immersed in raw Chaos...."
    IDS_MSG_21667    "You achieve oneness of Chaos...."
    IDS_MSG_21668    "A mysterious force protects you from the Chaos!"
    IDS_MSG_21669    "Wow.... You feel a bit smug."
    IDS_MSG_21670    "Uh oh...."
    IDS_MSG_21671    "Nothing mysterious happens this time...."
    IDS_MSG_21672    "Congratulations! You've achieved maximal entropy!"
    IDS_MSG_21673    "You move through the hedges freely."
    IDS_MSG_21674    "You struggle in the brambly hedge... "
    IDS_MSG_21675    "You are stabbed by thorns!"
    IDS_MSG_21676    "The thorns were poisonous!"
    IDS_MSG_21677    "You seem to have gotten stuck in the hedge."
    IDS_MSG_21678    "Your cloak was torn on the brambles!"
    IDS_MSG_21679    "Ouch! These thorns are scratchy!"
    IDS_MSG_21680    "You make your way through unscathed."
    IDS_MSG_21681    "Very clever -- walking into a pool of lava..."
    IDS_MSG_21682    "Your horse is incinerated... You fall in too!"
    IDS_MSG_21683    "Strangely enough, you don't seem terribly affected."
    IDS_MSG_21684    "You boldly stride through the curtain of fire..."
    IDS_MSG_21685    "Your horse is fried and so are you..."
    IDS_MSG_21686    "You fall through a dimensional portal!"
    IDS_MSG_21687    "You enter the infinite abyss!"
    IDS_MSG_21688    "As you fall you see before you what seems like"
    IDS_MSG_21689    "an infinite congerie of iridescent bubbles."
    IDS_MSG_21690    "You have met Yog Sothoth!!!"
    IDS_MSG_21691    "The All-In-One must have taken pity on you."
    IDS_MSG_21692    "A transdimensional portal appears..."
    IDS_MSG_21693    "You fall..."
    IDS_MSG_21694    "and fall... "
    IDS_MSG_21695    "Finally,you emerge through an interdimensional interstice..."
    IDS_MSG_21696    "You emerge high above the ground!!!!"
    IDS_MSG_21697    "Yaaaaaaaah........"
    IDS_MSG_21698    "You built up some velocity during your fall, though...."
    IDS_MSG_21699    "You walk onto a shimmering disk...."
    IDS_MSG_21700    "The disk vanishes, and a glow surrounds you."
    IDS_MSG_21701    "You feel weightless.... You feel ghostly...."
    IDS_MSG_21702    "Go up, down, or neither [u,d,ESCAPE] "
    IDS_MSG_21703    "How many levels?"
    IDS_MSG_21704    ".."
    IDS_MSG_21705    "...and keep going up!  You hang in mid air..."
    IDS_MSG_21706    """What goes up..."""
    IDS_MSG_21707    "The lift gives out partway..."
    IDS_MSG_21708    "You rematerialize....."
    IDS_MSG_21709    "This pool seems to be enchanted...."
    IDS_MSG_21710    "Your horse is polymorphed into a fig newton."
    IDS_MSG_21711    "Whatever it was, your horse enjoyed it...."
    IDS_MSG_21712    "Oh no! You encounter the DREADED AQUAE MORTIS..."
    IDS_MSG_21713    "The DREADED AQUAE MORTIS throttles you within inches...."
    IDS_MSG_21714    "but for some reason chooses to let you escape."
    IDS_MSG_21715    "You drop your weapon in the pool! It's gone forever!"
    IDS_MSG_21716    "Your weapon leaves the pool with a new edge...."
    IDS_MSG_21717    "You feel unfortunate."
    IDS_MSG_21718    "You feel healthier after the dip..."
    IDS_MSG_21719    "Oooh, a tainted pool..."
    IDS_MSG_21720    "Wow! A pool of azoth!"
    IDS_MSG_21721    "The pool seems to have dried up."
    IDS_MSG_21722    "You climb over the unstable pile of rubble...."
    IDS_MSG_21723    "No problem!"
    IDS_MSG_21724    "You tumble and fall in a small avalanche of debris!"
    IDS_MSG_21725    "You're trapped in the pile!"
    IDS_MSG_21726    "Click."
    IDS_MSG_21727    "Smash! You've been hit by a falling portcullis!"
    IDS_MSG_21728    "You hear heavy walls slamming down!"
    IDS_MSG_21729    "You hear the sound of steel on stone!"
    IDS_MSG_21730    "Geronimo!"
    IDS_MSG_21731    "You leap into the void."
    IDS_MSG_21732    "Death peers over the edge and gazes quizzically at you...."
    IDS_MSG_21733    "'Bye-bye,' he says... 'We'll meet again.'"
    IDS_MSG_21734    "The flames leap up, and the heat is incredible."
    IDS_MSG_21735    "You feel the terrible heat despite your immunity to fire!"
    IDS_MSG_21736    "Enter the flames? [yn] "
    IDS_MSG_21737    "You feel like you are being incinerated! Jump back? [yn] "
    IDS_MSG_21738    "Phew! That was close!"
    IDS_MSG_21739    "That's odd, the flame seems to have cooled down now...."
    IDS_MSG_21740    "A flicker of fire seems to dance above the void nearby."
    IDS_MSG_21741    "The flames seem to have leached away all your mana!"
    IDS_MSG_21742    "You flinch away from the all-consuming fire."
    IDS_MSG_21743    "The fluid seems murky and unknowably deep."
    IDS_MSG_21744    "It bubbles and hisses threateningly."
    IDS_MSG_21745    "You don't feel sanguine about trying to breathe that stuff!"
    IDS_MSG_21746    "The vapor burns despite your immunity to acid!"
    IDS_MSG_21747    "Enter the fluid? [yn] "
    IDS_MSG_21748    "You choke...."
    IDS_MSG_21749    "Your lungs burn...."
    IDS_MSG_21750    "Your body begins to disintegrate.... Leave the pool? [yn] "
    IDS_MSG_21751    "That's odd, the fluid seems to have been neutralized...."
    IDS_MSG_21752    "A moist miasma wafts above the void nearby."
    IDS_MSG_21753    "The bubbling fluid has destroyed your constitution!"
    IDS_MSG_21754    "You step back from the pool of acid."
    IDS_MSG_21755    "The whirlwind spins wildly and crackles with lightning."
    IDS_MSG_21756    "You feel static cling despite your immunity to electricity!"
    IDS_MSG_21757    "Enter the storm? [yn] "
    IDS_MSG_21758    "You are buffeted and burnt by the storm...."
    IDS_MSG_21759    "You begin to lose consciousness.... Leave the storm? [yn] "
    IDS_MSG_21760    "That's odd, the storm subsides...."
    IDS_MSG_21761    "A gust of wind brushes past the void nearby."
    IDS_MSG_21762    "The swirling storm has destroyed your intelligence!"
    IDS_MSG_21763    "You step back from the ominous whirlwind."
    IDS_MSG_21764    "The tendrilled mass reaches out for you from the muddy ooze."
    IDS_MSG_21765    "A splash of salt water does nothing to dissuade the vines."
    IDS_MSG_21766    "Enter the overgrown mire? [yn] "
    IDS_MSG_21767    "You are being dragged into the muck. Suckers bite you...."
    IDS_MSG_21768    "You're about to be entangled.... Leave the mud? [yn] "
    IDS_MSG_21769    "That's odd, the vine withdraws...."
    IDS_MSG_21770    "A spatter of dirt sprays into the void nearby."
    IDS_MSG_21771    "The tendril has destroyed your strength!"
    IDS_MSG_21772    "You step back from the ominous vegetation."
    IDS_MSG_21773    "You feel regenerated."
    IDS_MSG_21774    "There is a noise like a wild horse's neigh."
    IDS_MSG_21775    "You spin around, and don't see anyone around at all"
    IDS_MSG_21776    "except for a spurred black cloaked figure carrying a scythe."
    IDS_MSG_21777    "Death coughs apologetically. He seems a little embarrassed."
    IDS_MSG_21778    "A voice peals out:"
    IDS_MSG_21779    "'An Adept must be able to conquer Death himself...."
    IDS_MSG_21780    "You are at the brink of an endless void. Enter it? [yn] "
    IDS_MSG_21781    "You fall forever. Eventually you die of starvation."
    IDS_MSG_21782    "You enter the void."
    IDS_MSG_21783    "You feel a sudden surge of power from five directions."
    IDS_MSG_21784    "The flow of power is disrupted by something!"
    IDS_MSG_21785    "The power is unbalanced! You lose control!"
    IDS_MSG_21786    "Each of your cells explodes with a little scream of pain."
    IDS_MSG_21787    "Your disrupted essence merges with the megaflow."
    IDS_MSG_21788    "The hungry void swallows you whole!"
    IDS_MSG_21789    "Your being dissipates with a pathetic little sigh...."
    IDS_MSG_21790    "The flow of power rages through your body,"
    IDS_MSG_21791    "but you manage to master the surge!"
    IDS_MSG_21792    "You feel adept...."
    IDS_MSG_21793    "With a thought, you soar up through the void to the"
    IDS_MSG_21794    "place from whence you came."
    IDS_MSG_21795    "As the platform of the Challenge dwindles beneath you"
    IDS_MSG_21796    "You see Death raise his scythe to you in a salute."
    IDS_MSG_21797    "You find yourself back in the Temple of Destiny."
    IDS_MSG_21798    "You back away from the edge...."
    IDS_MSG_21799    "A mysterious voice says: The Hunger of the Void must be satiated."
    IDS_MSG_21800    "A strange voice recites: Enter the Void as you entered the World."
    IDS_MSG_21801    "An eerie voice resounds: The Void is the fifth Elemental Station."
    IDS_MSG_21802    "Buffeting winds swirl you up!"
    IDS_MSG_21803    "You are jolted by lightning!"
    IDS_MSG_21804    "The whirlwind carries you off...."
    IDS_MSG_21805    "'I don't think we're in Kansas anymore, toto.'"
    IDS_MSG_21806    "You see a translucent stairway before you, leading down."
    IDS_MSG_21807    "Take it? [yn] "
    IDS_MSG_21808    "You see before you the arcane library of the Circle of Sorcerors."
    IDS_MSG_21809    "A stern voice thunders in the air around you:"
    IDS_MSG_21810    "'No unbelievers may enter these sacred precincts;"
    IDS_MSG_21811    "those who defile this shrine will be destroyed!"
    IDS_MSG_21812    "You have come upon a huge ornately appointed throne!"
    IDS_MSG_21813    "Sit in it? [yn] "
    IDS_MSG_21814    "The throne emits an eerie violet-black radiance."
    IDS_MSG_21815    "You find, to your horror, that you cannot get up!"
    IDS_MSG_21816    "You feel an abstract sucking sensation..."
    IDS_MSG_21817    "The radiance finally ceases. You can get up now."
    IDS_MSG_21818    "You hear the sound of a magic kazoo played by an asthmatic."
    IDS_MSG_21819    "Following some strange impulse, you raise the Sceptre...."
    IDS_MSG_21820    "You hear a magical fanfare, repeated three times."
    IDS_MSG_21821    "Strength."
    IDS_MSG_21822    "Constitution."
    IDS_MSG_21823    "Dexterity."
    IDS_MSG_21824    "Agility."
    IDS_MSG_21825    "Intelligence."
    IDS_MSG_21826    "Power."
    IDS_MSG_21827    "A mysterious voice mutters peevishly...."
    IDS_MSG_21828    "So what do you want now? A medal?"
    IDS_MSG_21829    "Mystic runes appear in the air before you:"
    IDS_MSG_21830    "They appear to describe some high-powered spell."
    IDS_MSG_21831    "You hear a distant voice...."
    IDS_MSG_21832    "'You may now tread the path of High Magic.'"
    IDS_MSG_21833    "Weird flickering lights play over the throne."
    IDS_MSG_21834    "You hear a strange droning sound, as of a magical"
    IDS_MSG_21835    "artifact stressed by excessive use...."
    IDS_MSG_21836    "With an odd tinkling sound the throne shatters!"
    IDS_MSG_21837    "Your sceptre reverberates with the noise, and"
    IDS_MSG_21838    "it too explodes in a spray of shards."
    IDS_MSG_21839    "You have found an extremely long stairway going straight up."
    IDS_MSG_21840    "The stairs are grilled steel and the bannister is rubber."
    IDS_MSG_21841    "Take the stairway? [yn] "
    IDS_MSG_21842    "The stairs suddenly start moving with a grind of gears!"
    IDS_MSG_21843    "You are wafted to the surface...."
    IDS_MSG_21844    "You have found a magical portal! Enter it? [yn] "
    IDS_MSG_21845    "A dulcet voice says: 'Jolly good show!'"
    IDS_MSG_21846    "This is a menhir carved of black marble with veins of gold."
    IDS_MSG_21847    "It emanates an aura of raw chaos, which is not terribly"
    IDS_MSG_21848    "surprising, considering its location."
    IDS_MSG_21849    "You feel an almost unbearable attraction to the stone."
    IDS_MSG_21850    "You find it extremely difficult to approach the stone."
    IDS_MSG_21851    "Touch it? [yn] "
    IDS_MSG_21852    "A sudden flux of energy surrounds you!"
    IDS_MSG_21853    "You feel stronger!"
    IDS_MSG_21854    "You step back from the ominous dolmech."
    IDS_MSG_21855    "This is a massive granite slab teetering dangerously on a corner."
    IDS_MSG_21856    "You feel a sense of balance as you regard it."
    IDS_MSG_21857    "A vortex of mana spins about you!"
    IDS_MSG_21858    "The cyclone whirls you off to a strange place!"
    IDS_MSG_21859    "You are being drained of experience! Step back? [yn] "
    IDS_MSG_21860    "The vortex calms down, dimishes, and then disappears."
    IDS_MSG_21861    "The vortex vanishes. Suddenly, there is a clap of thunder!"
    IDS_MSG_21862    "You step back from the unlikely boulder."
    IDS_MSG_21863    "This is a stele carved of blueish-green feldspar."
    IDS_MSG_21864    "You feel an aura of serenity rising from it, and your gaze"
    IDS_MSG_21865    "is attracted to the bulk of Star Peak to the North-East."
    IDS_MSG_21866    "You feel a subtle attraction to the stone."
    IDS_MSG_21867    "You find the stone extremely distasteful to contemplate."
    IDS_MSG_21868    "A matrix of power flows about you!"
    IDS_MSG_21869    "You feel more vigorous!"
    IDS_MSG_21870    "You step back from the strange obelisk."
    IDS_MSG_21871    "This is a grey and uninteresting stone."
    IDS_MSG_21872    "A feeling of nihility emanates from it."
    IDS_MSG_21873    "You feel negated."
    IDS_MSG_21874    "You back away from the strange rock."
    IDS_MSG_21875    "You have come on a weathered basaltic block."
    IDS_MSG_21876    "On the top surface is an indentation in human shape."
    IDS_MSG_21877    "You see old rust colored stains in the grain of the stone."
    IDS_MSG_21878    "You sense something awakening. Touch the block? [yn] "
    IDS_MSG_21879    "You sense great pain emanating from the ancient altar."
    IDS_MSG_21880    "Climb on to the block? [yn] "
    IDS_MSG_21881    "You are stuck fast to the block!"
    IDS_MSG_21882    "You feel your life-force being sucked away!"
    IDS_MSG_21883    "Hit ESCAPE to try and get up at any moment, SPACE to remain."
    IDS_MSG_21884    "You feel weaker."
    IDS_MSG_21885    "You feel your life fading."
    IDS_MSG_21886    "Your energy is vanishing."
    IDS_MSG_21887    "You are being drained."
    IDS_MSG_21888    "You manage to wrench yourself off the ancient altar!"
    IDS_MSG_21889    "You leave some skin behind, though...."
    IDS_MSG_21890    "A strange red glow arises from the altar."
    IDS_MSG_21891    "The glow surrounds you.... You sense gratitude."
    IDS_MSG_21892    "You a have a sense of rejection."
    IDS_MSG_21893    "A roil of fetid vapor smokes up from the altar."
    IDS_MSG_21894    "You sense an emotion of pique all around you."
    IDS_MSG_21895    "You retreat from the strange stone."
    IDS_MSG_21896    "You decide discretion to be the better part of valour."
    IDS_MSG_21897    "The stone seems to subside sleepily."
    IDS_MSG_21898    "You approach a giant crystal of some opaline material."
    IDS_MSG_21899    "Flashes of irridescent light glint from the object."
    IDS_MSG_21900    "You feel your attention being drawn by the intricate crystal."
    IDS_MSG_21901    "Look away from the interesting phenomenon? [yn] "
    IDS_MSG_21902    "Your gaze focuses deeply on the gem...."
    IDS_MSG_21903    "The crystal seems to open up and surround you!"
    IDS_MSG_21904    "Your mind has been enhanced by the experience!"
    IDS_MSG_21905    "You manage to wrench your gaze from the odd jewel."
